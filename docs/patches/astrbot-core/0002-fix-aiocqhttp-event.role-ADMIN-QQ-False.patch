基类 role 默认 'member' 且适配器从不赋值，而 4.4 的 is_admin() 只看 self.role，
于是群主 /set、群管用插件管理命令全被判无权。现在从 onebot 事件 sender.role 补：
owner 按 admin 对待，admin/member 原样。

另含此前未提交的改动：挡自发消息回灌、丢真正的空消息、mface 表情包不再整条丢弃。
---
 .../aiocqhttp/aiocqhttp_message_event.py      | 15 ++++++++++++++
 .../aiocqhttp/aiocqhttp_platform_adapter.py   | 20 ++++++++++++++++++-
 2 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/astrbot/core/platform/sources/aiocqhttp/aiocqhttp_message_event.py b/astrbot/core/platform/sources/aiocqhttp/aiocqhttp_message_event.py
index 6aeb1f84..e48314e0 100644
--- a/astrbot/core/platform/sources/aiocqhttp/aiocqhttp_message_event.py
+++ b/astrbot/core/platform/sources/aiocqhttp/aiocqhttp_message_event.py
@@ -33,6 +33,21 @@ class AiocqhttpMessageEvent(AstrMessageEvent):
     ) -> None:
         super().__init__(message_str, message_obj, platform_meta, session_id)
         self.bot = bot
+        # 基类 role 恒为 "member"，而 aiocqhttp 从不给它赋值，于是 AstrBot 4.4
+        # 的 is_admin()（只看 self.role）在 QQ 群里永远是 False——群主开 /set、
+        # 群管用插件管理命令全被判无权，PermissionType.ADMIN 形同虚设。
+        # 这里从 onebot 事件的 sender.role 补回来；群主按 admin 对待，
+        # 否则群主管不了自己的群反而比群管权限低。
+        try:
+            _raw = getattr(message_obj, "raw_message", None) or {}
+            _sender = _raw.get("sender") if isinstance(_raw, dict) else None
+            _role = str((_sender or {}).get("role") or "").strip().lower()
+            if _role == "owner":
+                self.role = "admin"
+            elif _role in ("admin", "member"):
+                self.role = _role
+        except Exception:
+            pass
 
     @staticmethod
     async def _from_segment_to_dict(segment: BaseMessageComponent) -> dict:
diff --git a/astrbot/core/platform/sources/aiocqhttp/aiocqhttp_platform_adapter.py b/astrbot/core/platform/sources/aiocqhttp/aiocqhttp_platform_adapter.py
index 2e4e22bc..450b9850 100644
--- a/astrbot/core/platform/sources/aiocqhttp/aiocqhttp_platform_adapter.py
+++ b/astrbot/core/platform/sources/aiocqhttp/aiocqhttp_platform_adapter.py
@@ -133,6 +133,22 @@ class AiocqhttpAdapter(Platform):
             if abm.sender.user_id == "2854196310":
                 # 屏蔽 QQ 管家的消息
                 return None
+            if str(abm.sender.user_id) == str(abm.self_id):
+                # 发视频/文件之后，QQ 会把这条自己发出去的消息回灌成一条入站 message
+                # 事件（内容为空）。不挡的话 bot 对着自己的话接茬，用户那边看到的
+                # 就是莫名其妙一句「在，说」「说事」。
+                logger.info("[aiocqhttp] 忽略自发消息 self=%s （此前会触发一次莫名其妙的接话）", abm.self_id)
+                return None
+            if (not abm.message
+                    and not str(getattr(abm, "message_str", "") or "").strip()
+                    # 原始段非空说明这是「有内容但我们不认识」的消息（mface 表情包、
+                    # 未知新段类型）。这种不能当空消息丢，否则 stealer 一个表情包都偷不到
+                    and not (event.get("message") or [])):
+                # 一个消息段都没有的空事件。QQ 时不时会把已读、客户端同步这类东西
+                # 回灌成空消息，进了 pipeline 每个插件都会对着空气接茬
+                # （私聊里那句没头没尾的「说事」就是这么来的）。戳一戳带 Poke 段，不算空。
+                logger.info("[aiocqhttp] 丢弃空消息 sender=%s", abm.sender.user_id)
+                return None
         elif event["post_type"] == "notice":
             abm = await self._convert_handle_notice_event(event)
         elif event["post_type"] == "request":
@@ -396,7 +412,9 @@ class AiocqhttpAdapter(Platform):
 
                 message_str += "".join(at_parts)
             elif t == "mface":
-                continue
+                # 商城表情/表情包：内容留在 raw_message 里给需要的人（stealer 靠它偷图），
+                # 这里只放个占位，别让整条消息因为「没有组件」被当空消息丢掉
+                abm.message.append(Face(id=str(m["data"].get("emoji_id") or "")))
             elif t == "markdown":
                 for m in m_group:
                     text = m["data"].get("markdown") or m["data"].get("content", "")
