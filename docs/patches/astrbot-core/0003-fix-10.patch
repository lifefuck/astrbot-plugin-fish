star_request 原来把 {e} 原文发到群里（sqlite 报错、绝对路径全在里面）；
现在只报插件名，细节留在日志，但「参数不足」这类用法提示仍原样回给用户。
command_group 空参数时整棵指令树刷屏，21 条指令一条 /meme 占满整屏，截断到 10 行。
---
 .../core/pipeline/process_stage/method/star_request.py   | 9 ++++++++-
 astrbot/core/star/filter/command_group.py                | 6 ++++++
 2 files changed, 14 insertions(+), 1 deletion(-)

diff --git a/astrbot/core/pipeline/process_stage/method/star_request.py b/astrbot/core/pipeline/process_stage/method/star_request.py
index 9cf76693..dadd99af 100644
--- a/astrbot/core/pipeline/process_stage/method/star_request.py
+++ b/astrbot/core/pipeline/process_stage/method/star_request.py
@@ -123,7 +123,14 @@ class StarRequestSubStage(Stage):
                 )
 
                 if not event.is_stopped() and event.is_at_or_wake_command:
-                    ret = f":(\n\n在调用插件 {md.name} 的处理函数 {handler.handler_name} 时出现异常：{e}"
+                    # 异常原文（sqlite 报错、绝对路径、变量值）不能发到群里：
+                    # 群友看到的是天书，顺手还拿到了你的目录结构。细节走日志。
+                    # 但「参数不足」这类是框架给的用法提示，属于用户输入错，要原样回
+                    if isinstance(e, ValueError) and "参数不足" in str(e):
+                        ret = str(e)
+                    else:
+                        ret = (f":(\n\n{md.name} 处理 {handler.handler_name} 时出错了，"
+                               f"具体原因写在机器人日志里")
                     event.set_result(MessageEventResult().message(ret))
                     yield
                     event.clear_result()
diff --git a/astrbot/core/star/filter/command_group.py b/astrbot/core/star/filter/command_group.py
index 2e064136..6aecc4a7 100755
--- a/astrbot/core/star/filter/command_group.py
+++ b/astrbot/core/star/filter/command_group.py
@@ -137,6 +137,12 @@ class CommandGroupFilter(HandlerFilter):
                 + "\n"
                 + self.print_cmd_tree(self.sub_command_filters, event=event, cfg=cfg)
             )
+            # 指令多的组（表情包 21 条）一条 /meme 能刷满整屏，还只是「参数不足」。
+            # 截到 10 行，剩下的让他自己去 help 里看
+            _lines = tree.splitlines()
+            if len(_lines) > 11:
+                tree = "\n".join(_lines[:10]) + (
+                    f"\n…（共 {len(_lines) - 1} 条，发 {self.group_name} help 看全部）")
             raise ValueError(
                 f"参数不足。{self.group_name} 指令组下有如下指令，请参考：\n" + tree,
             )
